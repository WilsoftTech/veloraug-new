// The production sign-in pages on auth.veloraug.com, Step 11D: static files
// only, no code. Build them first, then from the repository root:
//   npx --yes wrangler@4.157.0 deploy --config infra/cloudflare/auth/wrangler.jsonc
// See infra/README.md.
{
  "$schema": "../../../services/media_gateway/node_modules/wrangler/config-schema.json",
  "name": "veloraug-auth",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "auth.veloraug.com", "custom_domain": true }],
  "assets": {
    // npm run build:prod, in apps/auth_pages.
    "directory": "../../../apps/auth_pages/dist-prod",
    "not_found_handling": "single-page-application"
  }
}
