// The production web app on app.veloraug.com, Step 11D: static files only,
// no code. Build it first, then from the repository root:
//   npx --yes wrangler@4.157.0 deploy --config infra/cloudflare/app/wrangler.jsonc
// See infra/README.md.
{
  "$schema": "../../../services/media_gateway/node_modules/wrangler/config-schema.json",
  "name": "veloraug-app",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "app.veloraug.com", "custom_domain": true }],
  "assets": {
    // flutter build web --release --no-web-resources-cdn
    //   --dart-define-from-file=dart_defines.prod.json, in apps/client.
    "directory": "../../../apps/client/build/web",
    // Serve /auth.html as itself: it is the registered sign-in redirect, and
    // the default would send it on to /auth.
    "html_handling": "none",
    "not_found_handling": "single-page-application"
  }
}
