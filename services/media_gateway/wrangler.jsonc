// The media gateway's Cloudflare settings. Nothing here is secret: the
// signing key is a Worker secret, and locally in .dev.vars. See README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veloraug-media-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  // No preview addresses: each would be another way in.
  "preview_urls": false,
  "r2_buckets": [
    {
      // Private. Only this binding reads it. `wrangler dev` uses a local copy
      // in .wrangler/state, never the real bucket.
      "binding": "MEDIA",
      "bucket_name": "veloraug-dev"
    }
  ],
  "vars": {
    // The web app's origins, separated by commas. Android sends none.
    "ALLOWED_ORIGINS": "http://localhost:8765",
    // The API, asked whether a session-bound grant is still live
    // (Milestone 10). Not secret.
    "API_URL": "http://127.0.0.1:8000"
  },
  "env": {
    // Production, Step 11D: `npx wrangler deploy --env production`. Its own
    // Worker, bucket and signing key, on media.veloraug.com only.
    "production": {
      "name": "veloraug-media",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "media.veloraug.com", "custom_domain": true }],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "veloraug" }],
      "vars": {
        "ALLOWED_ORIGINS": "https://app.veloraug.com",
        "API_URL": "https://api.veloraug.com"
      }
    }
  }
}
