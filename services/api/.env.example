# Example only. Every value below is fake.
#
# Goes in: services/api/.env, a Git-ignored copy of this file.
#
# The API never loads .env itself. Docker Compose passes this file's values
# to the container (infra/compose.local.yaml). Run directly with Python, set
# the values in the terminal instead: see services/api/README.md, Settings.
#
# The three sign-in settings are used from Step 5E. The database setting is
# used from Step 5F. See docs/step-05a-neon-plan.md. The TMDB token is used
# from Step 6B. See docs/step-06a-catalogue-plan.md. The playback settings are
# used from Step 8B.

# --- Public configuration, not secret ---

# Purpose: the exact token issuer, and the base of the public key address (JWKS).
# Source:  Neon Console, development branch, Auth, Configuration. Copy it, don't
#          build it. It differs on every branch.
VELORAUG_NEON_AUTH_URL=https://ep-example.neonauth.eu-central-1.aws.neon.tech/neondb/auth

# Purpose: the audience a token must contain. An identifier, not an address.
# Source:  the protected resource configured on the Neon OAuth provider.
VELORAUG_API_RESOURCE=https://api-dev.veloraug.invalid

# Purpose: the OAuth clients allowed to call this API, as a JSON list.
# Source:  the IDs of the public web and Android clients. They have no secrets.
VELORAUG_NEON_AUTH_CLIENT_IDS=["REPLACE_ME_WEB_CLIENT_ID","REPLACE_ME_ANDROID_CLIENT_ID"]

# --- Secret. Never commit, share or put in Flutter ---

# Purpose: the API's database connection, as veloraug_app, through the pooler.
# Source:  written by scripts/create_app_role.py. Don't fill it in by hand.
#          The API refuses any other role, such as neondb_owner.
VELORAUG_DATABASE_URL=postgresql://veloraug_app:REPLACE_ME@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Purpose: the admin routes' connection, as veloraug_editor, Step 9C.
# Source:  written by scripts/create_app_role.py --role editor. Don't fill it
#          in by hand. Without it, the admin routes answer 503.
VELORAUG_EDITOR_DATABASE_URL=postgresql://veloraug_editor:REPLACE_ME@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Purpose: fetches movie details from TMDB, for the catalogue script and the API.
# Source:  themoviedb.org, Settings, API: the API Read Access Token, the long
#          one, copied with its copy button. Not the short API key, which isn't
#          needed. No quotes around it.
VELORAUG_TMDB_READ_ACCESS_TOKEN=REPLACE_ME

# Purpose: signs playback grants. Must be exactly the media gateway's
#          PLAYBACK_SIGNING_KEY (services/media_gateway/.dev.vars locally, a
#          Worker secret on Cloudflare). At least 32 characters. Used from
#          Step 8B. See docs/step-08a-playback-plan.md.
# Source:  python -c "import secrets; print(secrets.token_urlsafe(32))"
VELORAUG_PLAYBACK_SIGNING_KEY=REPLACE_ME_WITH_A_LONG_RANDOM_KEY_000000000

# --- Public configuration, not secret ---

# Purpose: the media gateway's address. Playback addresses start with it.
#          Set together with the key above, or neither.
# Source:  http://127.0.0.1:8787 for `npm run dev` in services/media_gateway,
#          or the Worker's workers.dev address once deployed.
VELORAUG_MEDIA_GATEWAY_URL=http://127.0.0.1:8787

# --- Passes and Pesapal, Step 10B. See docs/step-10a-payments-plan.md ---

# Purpose: when true, viewers who aren't admins need a running pass to watch.
#          Leave it false until prices are set and Pesapal works.
VELORAUG_PASSES_REQUIRED=false

# Purpose: Pesapal's API 3.0 keys. Secret. Paste them here, never in a
#          message. The sandbox's come from developer.pesapal.com; live keys
#          come with a Pesapal business account.
# VELORAUG_PESAPAL_CONSUMER_KEY=REPLACE_ME
# VELORAUG_PESAPAL_CONSUMER_SECRET=REPLACE_ME

# Purpose: sandbox or live. Not secret.
# VELORAUG_PESAPAL_ENVIRONMENT=sandbox

# Purpose: the notification address's ID, printed by
#          python -m app.pesapal register-ipn <address>. Not secret.
# VELORAUG_PESAPAL_IPN_ID=REPLACE_ME

# Purpose: this API's own address, where Pesapal sends viewers back to
#          /api/v1/passes/return. Not secret.
# VELORAUG_PUBLIC_API_URL=http://127.0.0.1:8000

# VELORAUG_MIGRATION_DATABASE_URL does not belong in this file. It is the owner
# connection, set in the owner's terminal only for the length of a migration.
