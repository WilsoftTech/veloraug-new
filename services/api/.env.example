# Example only. Every value below is fake.
#
# Goes in: services/api/.env, a Git-ignored copy of this file.
#
# The API never loads .env itself. Docker Compose passes this file's values
# to the container (infra/compose.local.yaml). Run directly with Python, set
# the values in the terminal instead: see services/api/README.md, Settings.
#
# The three sign-in settings are used from Step 5E. The database setting is
# used from Step 5F. See docs/step-05a-neon-plan.md.

# --- Public configuration, not secret ---

# Purpose: the exact token issuer, and the base of the public key address (JWKS).
# Source:  Neon Console, development branch, Auth, Configuration. Copy it, don't
#          build it. It differs on every branch.
VELORAUG_NEON_AUTH_URL=https://ep-example.neonauth.eu-central-1.aws.neon.tech/neondb/auth

# Purpose: the audience a token must contain. An identifier, not an address.
# Source:  the protected resource configured on the Neon OAuth provider.
VELORAUG_API_RESOURCE=https://api-dev.veloraug.invalid

# Purpose: the OAuth clients allowed to call this API, as a JSON list.
# Source:  the IDs of the public web and Android clients. They have no secrets.
VELORAUG_NEON_AUTH_CLIENT_IDS=["REPLACE_ME_WEB_CLIENT_ID","REPLACE_ME_ANDROID_CLIENT_ID"]

# --- Secret. Never commit, share or put in Flutter ---

# Purpose: the API's database connection.
# Source:  Neon Console, Connect, with the pooled option and the veloraug_app role.
#          The host contains -pooler. Never use the neondb_owner role here.
VELORAUG_DATABASE_URL=postgresql://veloraug_app:REPLACE_ME@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# VELORAUG_MIGRATION_DATABASE_URL does not belong in this file. It is the owner
# connection, set in the owner's terminal only for the length of a migration.
