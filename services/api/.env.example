# Example only. Nothing reads this file today.
#
# The API does not load .env files, and the code that would use this setting
# does not exist yet. Milestone 5C proposes it: see docs/step-05a-plan.md.
#
# This value is public, not a secret. Never add a Supabase secret or
# service-role key, or the database password, to this file: the planned
# verifier does not need them.

# Purpose: the API builds the expected token issuer and the public key address
#          (JWKS) from this.
# Source:  the Supabase dashboard of the VeloraUG development project.
# Goes in: services/api/.env, a Git-ignored copy of this file (proposed).
VELORAUG_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
