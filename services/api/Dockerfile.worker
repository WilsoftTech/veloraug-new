# The media worker's image, used locally and on the server.
# The API's code and packages, plus FFmpeg from Debian. See "Uploads" in
# README.md and docs/step-07a-uploads-plan.md.
FROM python:3.13-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv/api

COPY requirements.txt requirements-worker.txt ./
RUN pip install --no-cache-dir --disable-pip-version-check -r requirements-worker.txt

COPY app ./app

# The files above stay owned by root, so this user can read but not change them.
RUN useradd --system --no-create-home --shell /usr/sbin/nologin veloraug
USER veloraug

CMD ["python", "-m", "app.media_worker"]
