# Public, not a secret: it is built into pages that anyone can read.
# Purpose: the Neon Auth URL of the branch these pages sign in to.
# Source:  neon neon-auth status --branch development, the "Base URL" line.
# Goes in: apps/auth_pages/.env.local, a Git-ignored copy of this file.
VITE_NEON_AUTH_URL=https://ep-example.neonauth.us-east-2.aws.neon.tech/neondb/auth
